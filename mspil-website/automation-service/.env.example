# Server Configuration
PORT=3001
NODE_ENV=production

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Pexels API for stock images (free)
PEXELS_API_KEY=your_pexels_api_key_here

# LinkedIn Configuration
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_PAGE_ID=your_linkedin_page_id_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/mspil_automation

# Security
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=https://mspil.in

# News Sources
CHINIMANDI_URL=https://www.chinimandi.com/
NEWS_CHECK_INTERVAL=0 0 */6 * * * # Every 6 hours

# Rate Limiting
OPENAI_RATE_LIMIT=60 # requests per minute
LINKEDIN_RATE_LIMIT=100 # requests per day